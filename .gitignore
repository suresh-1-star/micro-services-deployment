# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (contains sensitive data/secrets)
*.tfvars
*.tfvars.json

# Ignore override and plan files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan

# Ignore CLI configuration files
.terraformrc
terraform.rc
# Ignore Word documents and temporary files
*.docx
~$*